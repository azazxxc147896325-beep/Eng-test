# Supabase Cloud > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL ของเว็บที่อนุญาตให้ Edge Functions เรียกกลับ (แก้เป็นโดเมนจริงตอน deploy)
APP_ORIGIN=http://localhost:4173

# Server-only secrets belong in Supabase secrets, never in VITE_* variables.
